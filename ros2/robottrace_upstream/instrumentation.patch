 void RelayNode::process_message(std::shared_ptr<rclcpp::SerializedMessage> msg)
 {
-  std::scoped_lock lock(pub_mutex_);
-  if (pub_) {
-    pub_->publish(*msg);
+  const auto entry = robottrace::now();
+  std_msgs::msg::String decoded;
+  try {
+    rclcpp::Serialization<std_msgs::msg::String>().deserialize_message(msg.get(), &decoded);
+  } catch (const std::exception &error) {
+    trace_.reject(error.what());
+    return;
   }
+  const auto seq = trace_.accept(decoded.data);
+  if (!seq) return;
+  trace_.record_at(seq, robottrace::Kind::Entry, entry);
+  {
+    std::scoped_lock lock(pub_mutex_);
+    if (pub_) {
+      trace_.record(seq, robottrace::Kind::PublishBegin);
+      pub_->publish(*msg);
+      trace_.record(seq, robottrace::Kind::PublishEnd);
+    }
+  }
+  trace_.record(seq, robottrace::Kind::Exit);
 }
 
