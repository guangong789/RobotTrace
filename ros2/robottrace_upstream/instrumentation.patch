+void RelayNode::report_ready()
+{
+  trace_.ready(sub_ ? sub_->get_publisher_count() : 0, pub_ ? pub_->get_subscription_count() : 0,
+    sub_ ? rt_external::qos(sub_->get_actual_qos()) : "null",
+    pub_ ? rt_external::qos(pub_->get_actual_qos()) : "null");
